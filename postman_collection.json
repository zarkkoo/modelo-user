{
  "info": {
    "name": "API Laravel Users & Tokens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Obtener 10 usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users",
          "host": ["{{base_url}}"],
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "2. Crear Usuario (Registro)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Juan Pérez\",\n  \"email\": \"juan@test.com\",\n  \"password\": \"12345678\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/register",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "register"]
        }
      }
    },
    {
      "name": "3. Iniciar Sesión (Login)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan@test.com\",\n  \"password\": \"12345678\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/login",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "login"]
        }
      }
    },
    {
      "name": "4. Actualizar Nombre (Con Token)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer <AQUÍ_EL_TOKEN_OBTENIDO_EN_LOGIN>" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Juan Carlos Actualizado\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/user/name",
          "host": ["{{base_url}}"],
          "path": ["api", "user", "name"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://testmodels.test"
    }
  ]
}